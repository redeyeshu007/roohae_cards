# Server
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/roohae_cards

# Auth
JWT_ACCESS_SECRET=change-me-access-secret-min-32-characters!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-characters!
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Seed admin (used by `npm run seed`)
SEED_ADMIN_EMAIL=admin@roohae.com
SEED_ADMIN_PASSWORD=Admin@12345
SEED_ADMIN_NAME=Roohae Admin

# Storage: "local" | "r2"
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=uploads

# Cloudflare R2 (only required when STORAGE_DRIVER=r2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=roohae-assets
R2_PUBLIC_BASE_URL=
